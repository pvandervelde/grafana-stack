
// Host metrics

prometheus.exporter.unix "host" { }

prometheus.scrape "host" {
  targets    = prometheus.exporter.unix.host.targets
  forward_to = [prometheus.relabel.hostname.receiver,]
}


// SystemD logs

// System log collection
loki.source.file "system_logs" {
  targets = [
    {
      // System logs
      __path__ = "/var/log/syslog",
      app      = "syslog",
    },
    {
      __path__ = "/var/log/auth.log",
      app      = "auth",
    },
    {
      __path__ = "/var/log/kern.log",
      app      = "kernel",
    },
    {
      __path__ = "/var/log/dpkg.log",
      app      = "dpkg",
    },
    {
      __path__ = "/var/log/apt/history.log",
      app      = "apt-history",
    },
    {
      __path__ = "/var/log/fail2ban.log",
      app      = "fail2ban",
    },
  ]

  forward_to = [loki.process.system_logs.receiver]
}

// Process system logs to add labels and filters
loki.process "system_logs" {
  forward_to = [loki.relabel.hostname.receiver]

  stage.json {
    expressions = {
      timestamp = "timestamp",
      level     = "level",
      message   = "message",
    }
  }
}

// Systemd journal logs
loki.source.journal "systemd" {
  forward_to = [loki.relabel.hostname.receiver]
}

//
// ARTIFACTORY
//

// Artifactory metrics collection
prometheus.scrape "artifactory" {
  targets = [{
    __address__ = "localhost:8081/artifactory/api/v1/metrics",
  }]
  forward_to = [prometheus.relabel.hostname.receiver]

  // Basic auth for Artifactory metrics endpoint
  basic_auth {
    username = env("ARTIFACTORY_USERNAME")
    password = env("ARTIFACTORY_PASSWORD")
  }
}


//
// SELF MONITORING
//

// Metrics

prometheus.exporter.self "alloy_local" {
}

prometheus.scrape "alloy_local" {
  targets    = prometheus.exporter.self.alloy_local.targets
  forward_to = [prometheus.relabel.hostname.receiver,]
}

// Loki configuration for log collection
loki.source.file "artifactory_logs" {
  targets = [
    {
      __path__ = "/var/opt/jfrog/artifactory/log/artifactory-service.log",
      app      = "artifactory-service",
    },
    {
      __path__ = "/var/opt/jfrog/artifactory/log/access.log",
      app      = "artifactory-access",
    },
    {
      __path__ = "/var/opt/jfrog/artifactory/log/request.log",
      app      = "artifactory-request",
    },
    {
      __path__ = "/var/opt/jfrog/artifactory/log/artifactory.log",
      app      = "artifactory-main",
    },
  ]

  forward_to = [loki.relabel.hostname.receiver]
}

// Logs

logging {
  level    = "info"
  format   = "json"
  write_to = [loki.relabel.hostname.receiver,]
}

// Traces

tracing {
  sampling_fraction = 0.1
  write_to          = [otelcol.exporter.otlp.local.input]
}

//
// SHARED
//

loki.relabel "hostname"{
	rule {
		target_label = "instance"
		replacement = constants.hostname
	}

  rule {
		target_label = "os"
		replacement = constants.os
	}

	forward_to = [loki.write.local.receiver]
}

prometheus.relabel "hostname" {
	rule {
		target_label = "instance"
		replacement  = constants.hostname
	}

  rule {
		target_label = "os"
		replacement  = constants.os
	}

	forward_to   = [prometheus.remote_write.local.receiver]
}

//
// ENDPOINTS
//

prometheus.remote_write "local" {
	endpoint {
		url = format(
			"http://%s/api/v1/push",
			coalesce(env("MIMIR_HOST"), "prometheus.docker.localhost"),
		)
	}
}

loki.write "local" {
	endpoint {
		url = format(
			"http://%s/loki/api/v1/push",
			coalesce(env("LOKI_HOST"), "logs.docker.localhost"),
		)
	}
}

otelcol.exporter.otlp "local" {
	client {
		endpoint = coalesce(env("TEMPO_HOST"), "traces.docker.localhost")

		tls {
			insecure = true
		}
	}
}