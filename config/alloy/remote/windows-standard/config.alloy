// Host metrics

prometheus.scrape "host" {
  targets = prometheus.exporter.windows.host.targets
  forward_to = [
    prometheus.relabel.hostname.receiver,
  ]
}

prometheus.exporter.windows "host" {
}

// Windows Event Log

loki.process "parse_eventlog" {
  forward_to = [
    loki.relabel.hostname.receiver,
  ]
  stage.json {
    expressions = {
      "source"  = "source",
    }
  }
  stage.labels {
    values = {
      "source"  = "source",
    }
  }
}

loki.source.windowsevent "system" {
  forward_to = [
    loki.process.parse_eventlog.receiver,
  ]
  eventlog_name = "System"
}
loki.source.windowsevent "application" {
  forward_to = [
    loki.process.parse_eventlog.receiver,
  ]
  eventlog_name = "Application"
}

loki.source.windowsevent "security" {
  forward_to = [
    loki.process.parse_eventlog.receiver,
  ]
  eventlog_name = "Security"
}

//
// SELF MONITORING
//

// Metrics

prometheus.exporter.self "alloy_local" {
}

prometheus.scrape "alloy_local" {
  targets    = prometheus.exporter.self.alloy_local.targets
  forward_to = [prometheus.relabel.hostname.receiver,]
  job_name   = "alloy"
}

// Logs

logging {
  level    = "info"
  format   = "json"
  write_to = [loki.relabel.hostname.receiver,]
}

// Traces

tracing {
  sampling_fraction = 0.1
  write_to          = [otelcol.exporter.otlphttp.local.input]
}

//
// SHARED
//

loki.relabel "hostname"{
    rule {
        target_label = "instance"
        replacement = constants.hostname
    }

  rule {
        target_label = "os"
        replacement = constants.os
    }

    forward_to = [loki.write.local.receiver]
}

prometheus.relabel "hostname" {
    rule {
        target_label = "instance"
        replacement  = constants.hostname
    }

  rule {
        target_label = "os"
        replacement  = constants.os
    }

    forward_to   = [prometheus.remote_write.local.receiver]
}

//
// ENDPOINTS
//

prometheus.remote_write "local" {
    endpoint {
        url = format(
            "https://%s/api/v1/push",
            coalesce(env("MIMIR_HOST"), "prometheus.docker.localhost"),
        )

    // tls_config {
        // 	cert_file = "/mnt/config/cert.pem"
        // 	key_file  = "/mnt/config/key.pem"
        // }
    }
}

loki.write "local" {
    endpoint {
        url = format(
            "https://%s/loki/api/v1/push",
            coalesce(env("LOKI_HOST"), "logs.docker.localhost"),
        )

    // tls_config {
        // 	cert_file = "/mnt/config/cert.pem"
        // 	key_file  = "/mnt/config/key.pem"
        // }
    }
}

otelcol.exporter.otlphttp "local" {
    client {
        endpoint = format(
            "https://%s",
            coalesce(env("TEMPO_HOST"), "traces.docker.localhost"),
        )

        // tls {
        // 	insecure_skip_verify = true
        // }
    }
}
